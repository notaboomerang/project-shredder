# Project Shredder — cloud secrets TEMPLATE
# -----------------------------------------------------------------------------
# On Streamlit Community Cloud: open your app -> Settings -> Secrets, and paste
# the two lines below (with YOUR real values). DO NOT commit real cookies to git
# (.streamlit/secrets.toml is gitignored; this .example file is safe to commit).
#
# Where to get the values: on your LAPTOP where you're logged into ESPN, open
# the app's "Cookies (advanced)" box — it shows espn_s2 and SWID — or copy them
# from your browser's cookies for fantasy.espn.com.

# Password gate for the PUBLIC cloud app. Set this so only people who know the
# password can open it (it uses YOUR ESPN cookies, so keep it private). Leave it
# out entirely on the desktop — the gate is skipped when no password is set.
app_password = "pick-a-password"

[espn]
espn_s2 = "PASTE_YOUR_espn_s2_VALUE_HERE"
swid = "{PASTE-YOUR-SWID-INCLUDING-BRACES}"
